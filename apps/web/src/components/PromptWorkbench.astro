---
import type {
  PersonaIntensity,
  PersonaLocale,
  PersonaManifestV2,
} from "@ai-agent-personas/core";
import UiIcon from "@/components/UiIcon.astro";
import type { CompiledLayerMap } from "@/lib/persona-data";
import { copy, intensities, personaPath } from "@/lib/site";

interface Props {
  persona: PersonaManifestV2;
  locale: PersonaLocale;
  layers: CompiledLayerMap;
  mode?: "preview" | "detail";
  instance?: string;
  commandTargetId?: string;
}

const {
  persona,
  locale,
  layers,
  mode = "detail",
  instance = "main",
  commandTargetId,
} = Astro.props;
const t = copy[locale];
const initialIntensity: PersonaIntensity = "balanced";
const initialPrompt = layers[locale].voice[initialIntensity];
const isPreview = mode === "preview";
const workbenchId = `${mode}-${instance}-${persona.id}-${locale}`;
const ui =
  locale === "en"
    ? {
        voice: "Voice",
        safety: "Safety",
        task: "Task",
        layer: "Layer",
        taskMode: "Task mode",
        chooseTaskMode: "Choose a Task mode",
        taskModeRequired: "Choose a Task mode to reveal its compiled prompt.",
      }
    : {
        voice: "Голос",
        safety: "Безопасность",
        task: "Задача",
        layer: "Слой",
        taskMode: "Режим задачи",
        chooseTaskMode: "Выберите режим задачи",
        taskModeRequired: "Выберите режим задачи, чтобы открыть собранный промпт.",
      };
const serializedLayers = JSON.stringify(layers)
  .replaceAll("<", "\\u003c")
  .replaceAll("\u2028", "\\u2028")
  .replaceAll("\u2029", "\\u2029");
---

<section
  class:list={["prompt-workbench", `prompt-workbench--${mode}`]}
  aria-label={isPreview ? `${ui.voice}: ${t.home.promptPreview}` : t.detail.systemPrompt}
  data-workbench
  data-mode={mode}
  data-copy-success={t.detail.copied}
  data-copy-failure={t.detail.copyFailed}
  data-update-success={t.detail.updated}
  data-prompt-unavailable={t.detail.promptUnavailable}
  data-task-mode-required={ui.taskModeRequired}
  data-prompt-label={t.detail.prompt}
  data-voice-label={ui.voice}
  data-safety-label={ui.safety}
  data-task-label={ui.task}
  data-persona-id={persona.id}
  data-command-target={commandTargetId}
>
  <slot name="identity" />

  {
    !isPreview && (
      <div class="layer-tabs" role="tablist" aria-label={ui.layer} data-layer-tabs>
        {(["voice", "safety", "task"] as const).map((layer, index) => (
          <button
            class="layer-tab"
            type="button"
            role="tab"
            aria-selected={layer === "voice" ? "true" : "false"}
            aria-controls={`${workbenchId}-prompt-region`}
            tabindex={index === 0 ? "0" : "-1"}
            data-layer={layer}
          >
            {ui[layer]}
          </button>
        ))}
      </div>
    )
  }

  <div class="prompt-workbench__controls">
    <label class="field-control" data-intensity-field>
      <span>{t.detail.intensity}</span>
      <span class="select-wrap">
        <select data-intensity aria-controls={`${workbenchId}-prompt-region`}>
          {
            intensities.map((intensity) => (
              <option value={intensity} selected={intensity === initialIntensity}>
                {t.labels[intensity]}
              </option>
            ))
          }
        </select>
        <UiIcon name="chevron" size={18} />
      </span>
    </label>

    {
      !isPreview && (
        <label class="field-control" data-task-mode-field hidden>
          <span>{ui.taskMode}</span>
          <span class="select-wrap">
            <select data-task-mode aria-controls={`${workbenchId}-prompt-region`}>
              <option value="">{ui.chooseTaskMode}</option>
              {layers[locale].taskModes.map((taskMode) => (
                <option value={taskMode.id}>{taskMode.name}</option>
              ))}
            </select>
            <UiIcon name="chevron" size={18} />
          </span>
        </label>
      )
    }

    <label class="field-control">
      <span>{t.detail.language}</span>
      <span class="select-wrap">
        <UiIcon name="globe" size={18} />
        <select
          data-locale
          data-mode={isPreview ? "preview" : "navigate"}
          data-en-url={personaPath("en", persona.id)}
          data-ru-url={personaPath("ru", persona.id)}
          aria-controls={`${workbenchId}-prompt-region`}
        >
          <option value="en" selected={locale === "en"}>{t.labels.english}</option>
          <option value="ru" selected={locale === "ru"}>{t.labels.russian}</option>
        </select>
        <UiIcon name="chevron" size={18} />
      </span>
    </label>
  </div>

  <div class="prompt-workbench__prompt" id={`${workbenchId}-prompt-region`}>
    <span class="eyebrow" data-prompt-heading>
      {isPreview ? `${ui.voice}: ${t.home.promptPreview}` : `${ui.voice} ${t.detail.prompt}`}
    </span>
    <pre tabindex="0" data-prompt-container><code data-prompt-output>{initialPrompt}</code></pre>
    <p class="prompt-workbench__empty" data-task-empty hidden>{ui.taskModeRequired}</p>
  </div>

  <div class="prompt-workbench__actions">
    <button class="button button--primary" type="button" data-copy-prompt>
      <UiIcon name="copy" />
      <span>{t.detail.copy}</span>
    </button>
    {
      !isPreview && (
        <button class="button button--secondary" type="button" data-download-prompt>
          <UiIcon name="download" />
          <span>{t.detail.download}</span>
        </button>
      )
    }
    <span class="action-status" role="status" aria-live="polite" data-action-status></span>
  </div>

  <script is:inline type="application/json" data-layer-data set:html={serializedLayers}></script>
</section>

<script>
  type RuntimeLayer = "voice" | "safety" | "task";
  type RuntimeTaskMode = {
    id: string;
    name: string;
    summary: string;
    suitability: string[];
    exclusions: string[];
    prompt: string;
  };
  type RuntimeLocaleLayers = {
    safety: string;
    voice: Record<string, string>;
    taskModes: RuntimeTaskMode[];
  };
  type RuntimeLayerMap = Record<string, RuntimeLocaleLayers>;

  const runtimeLocales = ["en", "ru"] as const;
  const runtimeIntensities = ["subtle", "balanced", "immersive"] as const;
  const runtimeLayers = ["voice", "safety", "task"] as const;

  function isRuntimeLayer(value: string | null): value is RuntimeLayer {
    return value !== null && (runtimeLayers as readonly string[]).includes(value);
  }

  function isLayerMap(value: unknown): value is RuntimeLayerMap {
    if (typeof value !== "object" || value === null) return false;
    const candidate = value as Record<string, unknown>;
    return runtimeLocales.every((locale) => {
      const localized = candidate[locale];
      if (typeof localized !== "object" || localized === null) return false;
      const layers = localized as Record<string, unknown>;
      if (typeof layers.safety !== "string" || layers.safety.length === 0) return false;
      if (typeof layers.voice !== "object" || layers.voice === null) return false;
      const voice = layers.voice as Record<string, unknown>;
      if (
        !runtimeIntensities.every(
          (intensity) => typeof voice[intensity] === "string" && voice[intensity].length > 0,
        )
      ) {
        return false;
      }
      if (!Array.isArray(layers.taskModes) || layers.taskModes.length === 0) return false;
      return layers.taskModes.every(
        (taskMode) =>
          typeof taskMode === "object" &&
          taskMode !== null &&
          typeof taskMode.id === "string" &&
          typeof taskMode.name === "string" &&
          typeof taskMode.summary === "string" &&
          Array.isArray(taskMode.suitability) &&
          Array.isArray(taskMode.exclusions) &&
          typeof taskMode.prompt === "string" &&
          taskMode.prompt.length > 0,
      );
    });
  }

  function initializeWorkbench(workbench: HTMLElement) {
    if (workbench.dataset.ready === "true") return;
    workbench.dataset.ready = "true";

    const intensity = workbench.querySelector<HTMLSelectElement>("[data-intensity]");
    const intensityField = workbench.querySelector<HTMLElement>("[data-intensity-field]");
    const taskMode = workbench.querySelector<HTMLSelectElement>("[data-task-mode]");
    const taskModeField = workbench.querySelector<HTMLElement>("[data-task-mode-field]");
    const locale = workbench.querySelector<HTMLSelectElement>("[data-locale]");
    const output = workbench.querySelector<HTMLElement>("[data-prompt-output]");
    const promptContainer = workbench.querySelector<HTMLElement>("[data-prompt-container]");
    const taskEmpty = workbench.querySelector<HTMLElement>("[data-task-empty]");
    const heading = workbench.querySelector<HTMLElement>("[data-prompt-heading]");
    const dataNode = workbench.querySelector<HTMLScriptElement>("[data-layer-data]");
    const status = workbench.querySelector<HTMLElement>("[data-action-status]");
    const copyButton = workbench.querySelector<HTMLButtonElement>("[data-copy-prompt]");
    const downloadButton = workbench.querySelector<HTMLButtonElement>("[data-download-prompt]");
    const command = workbench.dataset.commandTarget
      ? document.getElementById(workbench.dataset.commandTarget)
      : null;
    const layerTabs = Array.from(
      workbench.querySelectorAll<HTMLButtonElement>("[data-layer]"),
    );
    if (
      !intensity ||
      !intensityField ||
      !locale ||
      !output ||
      !promptContainer ||
      !taskEmpty ||
      !heading ||
      !dataNode ||
      !status ||
      !copyButton
    ) {
      return;
    }

    let parsedLayers: unknown;
    try {
      parsedLayers = JSON.parse(dataNode.textContent || "{}");
    } catch (error) {
      parsedLayers = error;
    }

    if (!isLayerMap(parsedLayers)) {
      const message = workbench.dataset.promptUnavailable ?? "Prompt data is unavailable.";
      output.textContent = message;
      status.textContent = message;
      intensity.disabled = true;
      locale.disabled = true;
      if (taskMode) taskMode.disabled = true;
      copyButton.disabled = true;
      if (downloadButton) downloadButton.disabled = true;
      console.error("AI Agent Personas: invalid compiled layer data", parsedLayers);
      return;
    }
    const stages = parsedLayers;
    let activeLayer: RuntimeLayer = "voice";

    const layerLabel = (layer: RuntimeLayer): string =>
      workbench.dataset[`${layer}Label`] ?? layer;

    const selectedTaskMode = (): RuntimeTaskMode | undefined =>
      stages[locale.value]?.taskModes.find((candidate) => candidate.id === taskMode?.value);

    const currentPrompt = (): string | undefined => {
      const localized = stages[locale.value];
      if (!localized) return undefined;
      if (activeLayer === "voice") return localized.voice[intensity.value];
      if (activeLayer === "safety") return localized.safety;
      return selectedTaskMode()?.prompt;
    };

    const selectionLabel = (): string => {
      const parts: Array<string | null | undefined> = [
        layerLabel(activeLayer),
        locale.selectedOptions[0]?.textContent,
      ];
      if (activeLayer === "voice") parts.push(intensity.selectedOptions[0]?.textContent);
      if (activeLayer === "task") parts.push(taskMode?.selectedOptions[0]?.textContent);
      return parts.filter(Boolean).join(" · ");
    };

    const currentCommand = (): string => {
      const base = `npx ai-agent-personas show ${workbench.dataset.personaId} --layer ${activeLayer}`;
      if (activeLayer === "voice") {
        return `${base} --locale ${locale.value} --intensity ${intensity.value}`;
      }
      if (activeLayer === "task") {
        return `${base} --mode ${taskMode?.value || "<task-mode-id>"} --locale ${locale.value}`;
      }
      return `${base} --locale ${locale.value}`;
    };

    const updatePrompt = (announce = true) => {
      intensityField.hidden = activeLayer !== "voice";
      if (taskModeField) taskModeField.hidden = activeLayer !== "task";
      layerTabs.forEach((tab) => {
        const selected = tab.dataset.layer === activeLayer;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      heading.textContent = `${layerLabel(activeLayer)} ${workbench.dataset.promptLabel ?? "prompt"}`;

      const prompt = currentPrompt();
      const hasPrompt = typeof prompt === "string" && prompt.length > 0;
      promptContainer.hidden = !hasPrompt;
      taskEmpty.hidden = hasPrompt;
      output.textContent = prompt ?? "";
      copyButton.disabled = !hasPrompt;
      if (downloadButton) downloadButton.disabled = !hasPrompt;
      if (command) command.textContent = currentCommand();

      if (announce) {
        status.textContent = hasPrompt
          ? `${workbench.dataset.updateSuccess ?? "Prompt updated"}: ${selectionLabel()}`
          : workbench.dataset.taskModeRequired ?? "Choose a Task mode.";
      }
    };

    const selectLayer = (layer: RuntimeLayer, announce = true, moveFocus = false) => {
      activeLayer = layer;
      updatePrompt(announce);
      if (moveFocus) layerTabs.find((tab) => tab.dataset.layer === layer)?.focus();
    };

    layerTabs.forEach((tab, index) => {
      const layer = tab.dataset.layer;
      if (!layer || !isRuntimeLayer(layer)) return;
      tab.addEventListener("click", () => selectLayer(layer));
      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % layerTabs.length;
        if (event.key === "ArrowLeft") {
          nextIndex = (index - 1 + layerTabs.length) % layerTabs.length;
        }
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = layerTabs.length - 1;
        if (nextIndex === undefined) return;
        const nextLayer = layerTabs[nextIndex]?.dataset.layer;
        if (!nextLayer || !isRuntimeLayer(nextLayer)) return;
        event.preventDefault();
        selectLayer(nextLayer, true, true);
      });
    });

    intensity.addEventListener("change", () => updatePrompt());
    taskMode?.addEventListener("change", () => updatePrompt());
    locale.addEventListener("change", () => {
      if (locale.dataset.mode === "navigate") {
        const nextUrl = locale.value === "ru" ? locale.dataset.ruUrl : locale.dataset.enUrl;
        if (!nextUrl) return;
        const parameters = new URLSearchParams({ layer: activeLayer });
        if (activeLayer === "voice") parameters.set("intensity", intensity.value);
        if (activeLayer === "task" && taskMode?.value) parameters.set("mode", taskMode.value);
        window.location.assign(`${nextUrl}?${parameters.toString()}#workbench`);
        return;
      }
      updatePrompt();
    });

    const parameters = new URLSearchParams(window.location.search);
    const requestedIntensity = parameters.get("intensity");
    if (
      requestedIntensity &&
      runtimeIntensities.includes(requestedIntensity as (typeof runtimeIntensities)[number])
    ) {
      intensity.value = requestedIntensity;
    }
    const requestedMode = parameters.get("mode");
    if (
      requestedMode &&
      taskMode &&
      Array.from(taskMode.options).some((option) => option.value === requestedMode)
    ) {
      taskMode.value = requestedMode;
    }
    const requestedLayer = parameters.get("layer");
    if (layerTabs.length > 0 && isRuntimeLayer(requestedLayer)) activeLayer = requestedLayer;
    updatePrompt(false);

    const copyText = async (value: string) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(value);
          return true;
        } catch {
          // Continue with the synchronous fallback below.
        }
      }

      const textarea = document.createElement("textarea");
      textarea.value = value;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      document.body.append(textarea);
      textarea.select();
      const legacyCopy = Reflect.get(document, "execCommand") as
        | ((commandId: string) => boolean)
        | undefined;
      const copied = typeof legacyCopy === "function" && legacyCopy.call(document, "copy");
      textarea.remove();
      return copied;
    };

    copyButton.addEventListener("click", async () => {
      const prompt = currentPrompt();
      if (!prompt) return;
      try {
        const copied = await copyText(prompt);
        if (copied) {
          status.textContent = `${workbench.dataset.copySuccess ?? "Copied"}: ${selectionLabel()}`;
          return;
        }
      } catch {
        // Selection fallback below keeps the prompt accessible for manual copy.
      }

      const range = document.createRange();
      range.selectNodeContents(output);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      status.textContent = `${workbench.dataset.copyFailure ?? "Copy failed"}: ${selectionLabel()}`;
    });

    downloadButton?.addEventListener("click", () => {
      const prompt = currentPrompt();
      if (!prompt) return;
      const suffix =
        activeLayer === "voice"
          ? `voice.${intensity.value}`
          : activeLayer === "task"
            ? `task.${taskMode?.value}`
            : "safety";
      const blob = new Blob([prompt], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = `${workbench.dataset.personaId}.${locale.value}.${suffix}.txt`;
      anchor.click();
      URL.revokeObjectURL(url);
      status.textContent = `${layerLabel(activeLayer)}: ${anchor.download}`;
    });
  }

  document.querySelectorAll<HTMLElement>("[data-workbench]").forEach(initializeWorkbench);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-workbench]").forEach(initializeWorkbench);
  });
</script>
