---
import type { PersonaId } from "@/lib/site";

interface Props {
  id: PersonaId;
  color: string;
  label: string;
  size?: "small" | "medium" | "large";
  decorative?: boolean;
}

const { id, color, label, size = "medium", decorative = false } = Astro.props;
---

<svg
  class:list={["persona-sigil", `persona-sigil--${size}`]}
  viewBox="0 0 240 280"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  style={`--sigil-color: ${color}`}
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : `${label} sigil`}
>
  <g stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M120 13 210 48v72c0 63-35 110-90 143-55-33-90-80-90-143V48Z" />
    <path d="M120 25 198 55v65c0 54-29 95-78 126-49-31-78-72-78-126V55Z" opacity=".45" />
    <path d="M46 219c-21-10-33-26-37-48M194 219c21-10 33-26 37-48" opacity=".7" />
    <path d="m27 181-13-5 6 12-8 7 14 1-1 14 11-9 10 8-3-14 12-7-14-3-2-14Z" opacity=".7" />
    <path d="m213 181 13-5-6 12 8 7-14 1 1 14-11-9-10 8 3-14-12-7 14-3 2-14Z" opacity=".7" />
    <path d="M99 46h42M109 37h22" opacity=".6" />

    {
      id === "teacher" && (
        <g>
          <path d="M67 100c18-9 35-7 53 6 18-13 35-15 53-6v75c-18-7-35-4-53 9-18-13-35-16-53-9Z" />
          <path d="M120 106v78M79 115c12-4 22-2 31 4M79 130c12-4 22-2 31 4M161 115c-12-4-22-2-31 4M161 130c-12-4-22-2-31 4" />
          <path d="m165 73 4 10 10 4-10 4-4 10-4-10-10-4 10-4Z" />
        </g>
      )
    }
    {
      id === "catgirl" && (
        <g>
          <path d="m76 105 9-31 26 21c6-2 12-2 18 0l26-21 9 31c8 10 12 23 12 38 0 33-24 55-56 55s-56-22-56-55c0-15 4-28 12-38Z" />
          <path d="M95 137c5-5 10-5 15 0M130 137c5-5 10-5 15 0M117 148h6l-3 4ZM120 152v7M107 160c8 6 18 6 26 0" />
          <path d="M82 178c-9 9-8 19 4 23l34-21 34 21c12-4 13-14 4-23-10-8-23-7-38 2-15-9-28-10-38-2Z" />
        </g>
      )
    }
    {
      id === "yandere" && (
        <g>
          <path d="M120 190S68 158 68 116c0-25 31-35 52-9 21-26 52-16 52 9 0 42-52 74-52 74Z" />
          <path d="m143 79 17 12-54 86-16 7 1-17Z" />
          <path d="m89 167 17 10M146 83l15 10" />
          <path d="M57 112h-9M192 112h-9M120 72v-9" opacity=".7" />
        </g>
      )
    }
    {
      id === "wizard" && (
        <g>
          <path d="m72 148 48-80 48 80c-29 13-67 13-96 0Z" />
          <path d="M92 115c13 8 27 12 43 12M57 154c37-11 85-11 126 0-7 16-27 25-63 25s-56-9-63-25Z" />
          <path d="m120 88 3 7 7 3-7 3-3 7-3-7-7-3 7-3ZM150 127l2 5 5 2-5 2-2 5-2-5-5-2 5-2Z" />
          <path d="M91 187c20-7 39-5 57 5v24c-18-8-37-10-57-4Z" />
        </g>
      )
    }
    {
      id === "detective" && (
        <g>
          <path d="M74 122c26 8 66 8 92 0l-14-13-8-38c-18 9-34 9-48 0l-8 38Z" />
          <path d="M63 127c35 13 79 13 114 0" />
          <circle cx="103" cy="157" r="26" />
          <path d="m122 176 27 27M93 157h20M103 147v20" />
          <path d="M159 91c9-7 16-4 21 7" opacity=".7" />
        </g>
      )
    }
    {
      id === "butler" && (
        <g>
          <path d="M79 88c4 45 2 83-10 114M161 88c-4 45-2 83 10 114M79 88l41 58 41-58M120 146v66" />
          <path d="m120 118-29-19v38l29 9 29-9V99Z" />
          <circle cx="120" cy="124" r="7" />
          <path d="M102 165h36M105 179h30" />
          <path d="M77 203c28 9 58 9 86 0" />
        </g>
      )
    }
    {
      id === "knight" && (
        <g>
          <path d="M120 63v139M105 75l15-22 15 22M93 101h54M101 101l6 12h26l6-12" />
          <path d="M72 119c11 4 27 2 48-8 21 10 37 12 48 8v47c0 25-16 42-48 54-32-12-48-29-48-54Z" />
          <path d="M120 119v90M82 150h76" opacity=".75" />
        </g>
      )
    }
  </g>
</svg>

<style>
  .persona-sigil {
    display: block;
    color: var(--sigil-color);
    flex: none;
    overflow: visible;
  }

  .persona-sigil--small {
    width: 76px;
    height: 89px;
  }

  .persona-sigil--medium {
    width: 148px;
    height: 173px;
  }

  .persona-sigil--large {
    width: min(100%, 330px);
    height: auto;
  }
</style>
