---
import type { PersonaLocale } from "@ai-agent-personas/core";
import UiIcon from "@/components/UiIcon.astro";
import { copy, intensities, personaPath } from "@/lib/site";

interface Props {
  personaId: string;
  locale: PersonaLocale;
}

const { personaId, locale } = Astro.props;
const t = copy[locale];
---

<div class="persona-controls" data-persona-controls data-persona-id={personaId}>
  <label class="field-control">
    <span>{t.detail.language}</span>
    <span class="select-wrap">
      <UiIcon name="globe" size={18} />
      <select
        data-controls-locale
        data-en-url={personaPath("en", personaId)}
        data-ru-url={personaPath("ru", personaId)}
      >
        <option value="en" selected={locale === "en"}>{t.labels.english}</option>
        <option value="ru" selected={locale === "ru"}>{t.labels.russian}</option>
      </select>
      <UiIcon name="chevron" size={18} />
    </span>
  </label>

  <label class="field-control">
    <span>{t.detail.intensity}</span>
    <span class="select-wrap">
      <select data-controls-intensity>
        {
          intensities.map((intensity) => (
            <option value={intensity} selected={intensity === "balanced"}>
              {t.labels[intensity]}
            </option>
          ))
        }
      </select>
      <UiIcon name="chevron" size={18} />
    </span>
  </label>
</div>

<script>
  function initializePersonaControls(controls: HTMLElement) {
    if (controls.dataset.ready === "true") return;
    controls.dataset.ready = "true";

    const locale = controls.querySelector<HTMLSelectElement>("[data-controls-locale]");
    const intensity = controls.querySelector<HTMLSelectElement>("[data-controls-intensity]");
    if (!locale || !intensity) return;

    const requestedIntensity = new URLSearchParams(window.location.search).get("intensity");
    if (
      requestedIntensity &&
      Array.from(intensity.options).some((option) => option.value === requestedIntensity)
    ) {
      intensity.value = requestedIntensity;
    }

    const announceIntensity = () => {
      document.dispatchEvent(
        new CustomEvent("persona:intensity", {
          detail: {
            personaId: controls.dataset.personaId,
            intensity: intensity.value,
          },
        }),
      );
    };

    intensity.addEventListener("change", announceIntensity);
    locale.addEventListener("change", () => {
      const nextUrl = locale.value === "ru" ? locale.dataset.ruUrl : locale.dataset.enUrl;
      if (nextUrl) window.location.assign(`${nextUrl}?intensity=${intensity.value}#workbench`);
    });

    document.addEventListener("persona:intensity", (event) => {
      const detail = (event as CustomEvent<{ personaId?: string; intensity?: string }>).detail;
      if (
        detail.personaId === controls.dataset.personaId &&
        detail.intensity &&
        detail.intensity !== intensity.value
      ) {
        intensity.value = detail.intensity;
      }
    });

    queueMicrotask(announceIntensity);
  }

  document.querySelectorAll<HTMLElement>("[data-persona-controls]").forEach(initializePersonaControls);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-persona-controls]").forEach(initializePersonaControls);
  });
</script>
