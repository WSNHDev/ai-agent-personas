{
  "name": "ai-agent-personas",
  "version": "0.1.0",
  "description": "Browse, compile, copy, export, and validate portable AI agent personas.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-CONTENT.md",
    "LICENSES.md",
    "NOTICE"
  ],
  "bin": {
    "ai-agent-personas": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./dist/schema/persona.schema.json",
    "./catalog.json": "./dist/core/catalog.json"
  },
  "scripts": {
    "prelint": "node scripts/embed-core.mjs",
    "pretypecheck": "node scripts/embed-core.mjs",
    "pretest": "node scripts/embed-core.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:pack": "node scripts/pack-smoke.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WSNHDev/ai-agent-personas.git",
    "directory": "packages/cli"
  },
  "homepage": "https://wsnhdev.github.io/ai-agent-personas/",
  "bugs": {
    "url": "https://github.com/WSNHDev/ai-agent-personas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@ai-agent-personas/core": "workspace:*",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "ai",
    "agent",
    "persona",
    "prompt",
    "cli"
  ],
  "license": "SEE LICENSE IN LICENSES.md"
}
