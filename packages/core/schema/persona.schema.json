{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wsnhdev.github.io/ai-agent-personas/schema/persona-v1.json",
  "title": "AI Agent Persona Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "category",
    "tags",
    "color",
    "locales",
    "behavior",
    "safety",
    "intensity",
    "license",
    "attribution"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "category": { "$ref": "#/$defs/nonEmptyString", "type": "string", "minLength": 2, "maxLength": 64 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 40
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "locales": { "$ref": "#/$defs/locales" },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goals", "rules", "avoid"],
      "properties": {
        "goals": { "$ref": "#/$defs/localizedStringArray" },
        "rules": { "$ref": "#/$defs/localizedStringArray" },
        "avoid": { "$ref": "#/$defs/localizedStringArray" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "rules"],
      "properties": {
        "rating": { "const": "SFW" },
        "rules": { "$ref": "#/$defs/localizedStringArray" }
      }
    },
    "intensity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtle", "balanced", "immersive"],
      "properties": {
        "subtle": { "$ref": "#/$defs/localizedString" },
        "balanced": { "$ref": "#/$defs/localizedString" },
        "immersive": { "$ref": "#/$defs/localizedString" }
      }
    },
    "license": { "const": "CC-BY-4.0" },
    "attribution": { "$ref": "#/$defs/nonEmptyString", "type": "string", "minLength": 3, "maxLength": 300 }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "voiceStringArray": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "localizedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/nonEmptyString" },
        "ru": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "localizedStringArray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/stringArray" },
        "ru": { "$ref": "#/$defs/stringArray" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "assistant"],
      "properties": {
        "user": { "$ref": "#/$defs/nonEmptyString" },
        "assistant": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "localeContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "greeting",
        "traits",
        "principles",
        "basePrompt",
        "examples"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString", "type": "string", "maxLength": 80 },
        "summary": { "$ref": "#/$defs/nonEmptyString", "type": "string", "maxLength": 400 },
        "greeting": { "$ref": "#/$defs/nonEmptyString", "type": "string", "maxLength": 1000 },
        "traits": { "$ref": "#/$defs/voiceStringArray" },
        "principles": { "$ref": "#/$defs/voiceStringArray" },
        "basePrompt": { "$ref": "#/$defs/nonEmptyString" },
        "examples": {
          "type": "array",
          "minItems": 6,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/example" }
        }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/localeContent" },
        "ru": { "$ref": "#/$defs/localeContent" }
      }
    }
  }
}
