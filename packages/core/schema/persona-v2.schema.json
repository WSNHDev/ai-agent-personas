{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wsnhdev.github.io/ai-agent-personas/schema/persona-v2.json",
  "title": "AI Agent Persona Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "category",
    "tags",
    "color",
    "display",
    "safety",
    "taskModes",
    "voice",
    "compatibility",
    "license",
    "attribution"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "category": {
      "allOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "string", "minLength": 2, "maxLength": 64 }
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 40
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "greeting"],
      "properties": {
        "name": { "$ref": "#/$defs/localizedName" },
        "summary": { "$ref": "#/$defs/localizedSummary" },
        "greeting": { "$ref": "#/$defs/localizedGreeting" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "risks", "preActionRules", "boundaries"],
      "properties": {
        "rating": { "const": "SFW" },
        "risks": { "$ref": "#/$defs/localizedList1To8" },
        "preActionRules": { "$ref": "#/$defs/localizedList1To8" },
        "boundaries": { "$ref": "#/$defs/localizedList1To8" }
      }
    },
    "taskModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/taskMode" }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directions", "avoid", "intensity", "examples"],
      "properties": {
        "directions": { "$ref": "#/$defs/localizedList4To12" },
        "avoid": { "$ref": "#/$defs/localizedList2To12" },
        "intensity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subtle", "balanced", "immersive"],
          "properties": {
            "subtle": { "$ref": "#/$defs/localizedString" },
            "balanced": { "$ref": "#/$defs/localizedString" },
            "immersive": { "$ref": "#/$defs/localizedString" }
          }
        },
        "examples": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/voiceExample" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyTaskModeId"],
      "properties": {
        "legacyTaskModeId": { "$ref": "#/$defs/id" }
      }
    },
    "license": { "const": "CC-BY-4.0" },
    "attribution": {
      "allOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "string", "minLength": 3, "maxLength": 300 }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "localizedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/nonEmptyString" },
        "ru": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "string", "maxLength": 80 }
          ]
        },
        "ru": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "string", "maxLength": 80 }
          ]
        }
      }
    },
    "localizedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "string", "maxLength": 400 }
          ]
        },
        "ru": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "string", "maxLength": 400 }
          ]
        }
      }
    },
    "localizedGreeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "string", "maxLength": 1000 }
          ]
        },
        "ru": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "string", "maxLength": 1000 }
          ]
        }
      }
    },
    "localizedList1To8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/list1To8" },
        "ru": { "$ref": "#/$defs/list1To8" }
      }
    },
    "localizedList2To12": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/list2To12" },
        "ru": { "$ref": "#/$defs/list2To12" }
      }
    },
    "localizedList4To12": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/list4To12" },
        "ru": { "$ref": "#/$defs/list4To12" }
      }
    },
    "list1To8": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "list2To12": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "list4To12": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "taskMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "suitability",
        "exclusions",
        "instructions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/localizedName" },
        "summary": { "$ref": "#/$defs/localizedSummary" },
        "suitability": { "$ref": "#/$defs/localizedList1To8" },
        "exclusions": { "$ref": "#/$defs/localizedList1To8" },
        "instructions": { "$ref": "#/$defs/localizedList2To12" }
      }
    },
    "voiceExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "rendered"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/localizedString" },
        "rendered": { "$ref": "#/$defs/localizedString" }
      }
    }
  }
}
